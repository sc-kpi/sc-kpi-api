# ═══════════════════════════════════════════════════════════════
# SC-KPI API — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Sensitive values are left blank — you MUST provide them.
# Non-sensitive values show the defaults for documentation.
# ═══════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Docker Compose infra (used by docker-compose.yml) ───────────
POSTGRES_DB=sc_kpi
POSTGRES_USER=sc_kpi_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=<base64-encoded-secret-at-least-256-bits>
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000
JWT_REMEMBER_ME_REFRESH_EXPIRATION=7776000000

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── App URLs ────────────────────────────────────────────────────
API_BASE_URL=https://api.sc.kpi.ua
APP_CONTACT_URL=https://sc.kpi.ua

# ── Security ───────────────────────────────────────────────────
BCRYPT_STRENGTH=12

# ── Async Thread Pool ─────────────────────────────────────────
ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=8
ASYNC_QUEUE_CAPACITY=100
